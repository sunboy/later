{
  "name": "later-genui-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Generative UI lab: agents send typed view specs, the client owns the pixels.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/artifact.mjs",
    "check:specs": "esbuild scripts/check-specs.ts --bundle --platform=node --format=esm --outfile=dist/check-specs.mjs --log-level=warning && node dist/check-specs.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3",
    "@types/react-dom": "18.3",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "5.6",
    "vite": "^6.4.6",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
